# Variabili d'ambiente del backend MySenca.
# Copia questo file in `.env` (già escluso da git) e compila i valori.
# In produzione (Render) vanno impostate in Environment, non in un file.
#
# Legenda: [OBBLIGATORIA] = il server non parte senza.
#          [CONSIGLIATA]  = parte, ma con comportamento degradato.
#          [OPZIONALE]    = ha un default sensato.

# --- Server -----------------------------------------------------------------
# [OPZIONALE] Porta HTTP. Default 3001.
PORT=3001
# [OPZIONALE] "production" attiva i controlli di avvio (CORS_ORIGIN, WEB_CONCURRENCY).
NODE_ENV=development
# [OBBLIGATORIA in produzione] Origini ammesse per CORS, separate da virgola.
# In sviluppo, se vuota, CORS rifiuta tutte le origini esterne (il frontend Vite
# passa dal proxy /api, quindi non serve).
CORS_ORIGIN=
# [OPZIONALE] Deve restare 1: l'audit log usa una cache in memoria a istanza singola.
WEB_CONCURRENCY=1

# --- Notion (database) ------------------------------------------------------
# [OBBLIGATORIA] Token dell'integrazione Notion.
NOTION_TOKEN=

# --- Sicurezza --------------------------------------------------------------
# [CONSIGLIATA] Chiave di firma dei token di sessione. Se manca ne viene generata
# una temporanea e tutte le sessioni decadono a ogni riavvio.
# Genera con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# [OBBLIGATORIA] Chiave di cifratura dei dati sensibili (minimo 32 caratteri).
# NON cambiarla dopo il primo avvio: i dati già cifrati diventerebbero illeggibili.
ENCRYPTION_KEY=

# --- n8n (webhook) ----------------------------------------------------------
# [OBBLIGATORIA] Segreto condiviso inviato nell'header X-MySenca-Secret.
N8N_WEBHOOK_SECRET=
# [OBBLIGATORIA] Webhook n8n per l'invio delle email.
N8N_EMAIL_WEBHOOK_URL=
# [OBBLIGATORIA] Webhook n8n dedicato all'invio dei documenti privacy.
N8N_DOCUMENTI_PRIVACY_WEBHOOK_URL=
# [OPZIONALE] URL base dei webhook n8n usati dal proxy.
N8N_BASE_URL=

# --- Monitoraggio vulnerabilità (GitHub Actions → backend) -------------------
# [CONSIGLIATA] Segreto atteso nell'header x-audit-secret quando la Action invia
# il report settimanale. Stesso valore del secret SECURITY_AUDIT_SECRET su GitHub.
SECURITY_AUDIT_SECRET=
